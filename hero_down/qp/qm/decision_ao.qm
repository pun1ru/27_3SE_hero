<?xml version="1.0" encoding="UTF-8"?>
<model version="7.0.3" links="1" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.state-machine.com/qm/qm7.xsd">
 <documentation>About this example:
-------------------
Simple &quot;Blinky&quot; console application for workstations (Windows, Linux, macOS)
(see &quot;QM Tutorial&quot; at: https://www.state-machine.com/qm/gs_tut.html)

This example demonstrates:
- Active object (Blinky) with state machine
- Board Support Package abstraction for portability
- BSP implementation for desktop OS (Windows, Linux, MacOS)
- Platform-independent main() function
- Makefile to build the generated code on desktop OS (Windows, Linux, MacOS)
- Customized tools for building the generated code directly from QM

Building the example:
---------------------
To build this example, you will need the QP/C framework installed on your
computer and the GNU-GCC compiler. Both of them will be available if you
install the QP-bundle from:

https://www.state-machine.com/#Downloads

Running the example:
--------------------
This example is a simple console application, which you can run from a terminal.

For more QM examples for QP/C see:
https://www.state-machine.com/qpc/exa.html</documentation>
 <!--${qpc}-->
 <framework name="qpc"/>
 <!--${Hero_Demo}-->
 <package name="Hero_Demo" stereotype="0x00">
  <!--${Hero_Demo::DecisionAO}-->
  <class name="DecisionAO" superclass="qpc::QActive">
   <!--${Hero_Demo::DecisionAO::ctrl_terminal}-->
   <attribute name="ctrl_terminal" type="uint8_t" visibility="0x00" properties="0x00"/>
   <!--${Hero_Demo::DecisionAO::chassis_mode}-->
   <attribute name="chassis_mode" type="uint8_t" visibility="0x00" properties="0x00"/>
   <!--${Hero_Demo::DecisionAO::sniper}-->
   <attribute name="sniper" type="uint8_t" visibility="0x00" properties="0x00"/>
   <!--${Hero_Demo::DecisionAO::fric_mode}-->
   <attribute name="fric_mode" type="uint8_t" visibility="0x00" properties="0x00"/>
   <!--${Hero_Demo::DecisionAO::stir_mode}-->
   <attribute name="stir_mode" type="uint8_t" visibility="0x00" properties="0x00"/>
   <!--${Hero_Demo::DecisionAO::joint_mode}-->
   <attribute name="joint_mode" type="uint8_t" visibility="0x00" properties="0x00"/>
   <!--${Hero_Demo::DecisionAO::stand_mode}-->
   <attribute name="stand_mode" type="uint8_t" visibility="0x00" properties="0x00"/>
   <!--${Hero_Demo::DecisionAO::mouse_fix}-->
   <attribute name="mouse_fix" type="uint8_t" visibility="0x00" properties="0x00"/>
   <!--${Hero_Demo::DecisionAO::cam_target}-->
   <attribute name="cam_target" type="uint8_t" visibility="0x00" properties="0x00"/>
   <!--${Hero_Demo::DecisionAO::world_enable}-->
   <attribute name="world_enable" type="uint8_t" visibility="0x00" properties="0x00"/>
   <!--${Hero_Demo::DecisionAO::stable}-->
   <attribute name="stable" type="uint8_t" visibility="0x00" properties="0x00"/>
   <!--${Hero_Demo::DecisionAO::timeEvt_test}-->
   <attribute name="timeEvt_test" type="QTimeEvt" visibility="0x02" properties="0x00"/>
   <!--${Hero_Demo::DecisionAO::rc_lost_flag}-->
   <attribute name="rc_lost_flag" type="uint8_t" visibility="0x02" properties="0x00"/>
   <!--${Hero_Demo::DecisionAO::can_enable}-->
   <attribute name="can_enable" type="uint8_t" visibility="0x00" properties="0x00"/>
   <!--${Hero_Demo::DecisionAO::inst}-->
   <attribute name="inst" type="DecisionAO" visibility="0x00" properties="0x01"/>
   <!--${Hero_Demo::DecisionAO::State_Stable}-->
   <operation name="State_Stable" type="void" visibility="0x00" properties="0x00">
    <code>me-&gt;stable=1;</code>
   </operation>
   <!--${Hero_Demo::DecisionAO::Stable_Unstable}-->
   <operation name="Stable_Unstable" type="void" visibility="0x00" properties="0x00">
    <code>me-&gt;stable=0;</code>
   </operation>
   <!--${Hero_Demo::DecisionAO::is_Stable}-->
   <operation name="is_Stable" type="uint8_t" visibility="0x00" properties="0x00">
    <code>return me-&gt;stable;</code>
   </operation>
   <!--${Hero_Demo::DecisionAO::SM}-->
   <statechart properties="0x00">
    <!--${Hero_Demo::DecisionAO::SM::initial}-->
    <initial target="../1">
     <initial_glyph conn="61,4,4,0,10">
      <action box="0,2,10,2"/>
     </initial_glyph>
    </initial>
    <!--${Hero_Demo::DecisionAO::SM::Protected}-->
    <state name="Protected">
     <entry>me-&gt;ctrl_terminal = CTRL_STOP;
me-&gt;chassis_mode = CHS_FOLLOW;
me-&gt;sniper = SNIPER_OFF;
me-&gt;fric_mode = FRIC_OFF;
me-&gt;stir_mode = STIR_LOCK;
me-&gt;joint_mode = JOINT_NORMAL;
me-&gt;stand_mode = STAND_NORMAL;
me-&gt;mouse_fix = MOUSE_FIX_ON;
me-&gt;cam_target = CAM_TARGET_MID;
me-&gt;world_enable = WORLD_ENABLE_ON;
me-&gt;can_enable = CAN_DISABLE;</entry>
     <!--${Hero_Demo::DecisionAO::SM::Protected::RC_LOST}-->
     <tran trig="RC_LOST" target="..">
      <tran_glyph conn="193,14,0,1,5,16">
       <action box="0,-2,10,2"/>
      </tran_glyph>
     </tran>
     <!--${Hero_Demo::DecisionAO::SM::Protected::Switch_RC}-->
     <tran trig="Switch_RC" target="../4">
      <action>me-&gt;ctrl_terminal = CTRL_REMOTE;</action>
      <tran_glyph conn="172,14,0,0,12">
       <action box="0,-2,10,2"/>
      </tran_glyph>
     </tran>
     <!--${Hero_Demo::DecisionAO::SM::Protected::Switch_PC}-->
     <tran trig="Switch_PC" target="../4">
      <action>me-&gt;ctrl_terminal = CTRL_PC;</action>
      <tran_glyph conn="161,14,0,0,12">
       <action box="0,-2,10,2"/>
      </tran_glyph>
     </tran>
     <!--${Hero_Demo::DecisionAO::SM::Protected::SWITCH_FINAL}-->
     <tran trig="SWITCH_FINAL">
      <tran_glyph conn="150,14,0,-1,5">
       <action box="-6,-2,19,2"/>
      </tran_glyph>
     </tran>
     <!--${Hero_Demo::DecisionAO::SM::Protected::NormalMode}-->
     <state name="NormalMode">
      <entry>//switch2Normal
me-&gt;chassis_mode = CHS_FOLLOW;
me-&gt;sniper = SNIPER_OFF;
me-&gt;fric_mode = FRIC_OFF;
me-&gt;stir_mode = STIR_ANGLE_CONTROL;
me-&gt;joint_mode = JOINT_NORMAL;
me-&gt;stand_mode = STAND_NORMAL;
me-&gt;mouse_fix = MOUSE_FIX_OFF;
me-&gt;cam_target = CAM_TARGET_MID;
me-&gt;world_enable = WORLD_ENABLE_OFF;
me-&gt;can_enable = CAN_ENABLE;</entry>
      <!--${Hero_Demo::DecisionAO::SM::Protected::NormalMode::SWITCH_FINAL}-->
      <tran trig="SWITCH_FINAL" target="../..">
       <tran_glyph conn="191,26,0,1,-4,18">
        <action box="4,-3,14,2"/>
       </tran_glyph>
      </tran>
      <!--${Hero_Demo::DecisionAO::SM::Protected::NormalMode::SWITCH_SNIPER}-->
      <tran trig="SWITCH_SNIPER" target="../8">
       <tran_glyph conn="135,26,0,0,29">
        <action box="0,16,15,2"/>
       </tran_glyph>
      </tran>
      <!--${Hero_Demo::DecisionAO::SM::Protected::NormalMode::SWITCH_STAND}-->
      <tran trig="SWITCH_STAND" target="../11">
       <tran_glyph conn="16,48,3,3,12">
        <action box="0,-2,13,2"/>
       </tran_glyph>
      </tran>
      <!--${Hero_Demo::DecisionAO::SM::Protected::NormalMode::SWITCH_REVOLVE}-->
      <tran trig="SWITCH_REVOLVE" target="../12">
       <tran_glyph conn="16,63,3,3,12">
        <action box="0,-2,16,2"/>
       </tran_glyph>
      </tran>
      <!--${Hero_Demo::DecisionAO::SM::Protected::NormalMode::SWITCH_STAIR}-->
      <tran trig="SWITCH_STAIR" target="../9">
       <tran_glyph conn="16,79,3,3,12">
        <action box="0,-2,13,2"/>
       </tran_glyph>
      </tran>
      <!--${Hero_Demo::DecisionAO::SM::Protected::NormalMode::SWITCH_BACK}-->
      <tran trig="SWITCH_BACK" target="../13">
       <tran_glyph conn="16,33,3,3,12">
        <action box="0,-2,15,2"/>
       </tran_glyph>
      </tran>
      <!--${Hero_Demo::DecisionAO::SM::Protected::NormalMode::Switch_PC}-->
      <tran trig="Switch_PC">
       <action>me-&gt;ctrl_terminal = CTRL_PC;</action>
       <tran_glyph conn="163,26,0,-1,5">
        <action box="0,-2,10,2"/>
       </tran_glyph>
      </tran>
      <!--${Hero_Demo::DecisionAO::SM::Protected::NormalMode::Switch_RC}-->
      <tran trig="Switch_RC">
       <action>me-&gt;ctrl_terminal = CTRL_REMOTE;</action>
       <tran_glyph conn="174,26,0,-1,5">
        <action box="0,-2,10,2"/>
       </tran_glyph>
      </tran>
      <!--${Hero_Demo::DecisionAO::SM::Protected::NormalMode::SniperMode}-->
      <state name="SniperMode">
       <entry>me-&gt;sniper = SNIPER_ON;</entry>
       <exit>me-&gt;sniper = SNIPER_OFF;</exit>
       <!--${Hero_Demo::DecisionAO::SM::Protected::NormalMode::SniperMode::SwitchR_down}-->
       <tran trig="SwitchR_down">
        <tran_glyph conn="119,61,3,-1,11">
         <action box="0,-2,12,2"/>
        </tran_glyph>
       </tran>
       <!--${Hero_Demo::DecisionAO::SM::Protected::NormalMode::SniperMode::SWITCH_SNIPER}-->
       <tran trig="SWITCH_SNIPER" target="../..">
        <tran_glyph conn="128,55,0,0,-29">
         <action box="-14,-12,15,3"/>
        </tran_glyph>
       </tran>
       <!--${Hero_Demo::DecisionAO::SM::Protected::NormalMode::SniperMode::SWITCH_WORLD}-->
       <tran trig="SWITCH_WORLD" target="../3">
        <tran_glyph conn="119,99,3,3,8">
         <action box="0,-2,16,2"/>
        </tran_glyph>
       </tran>
       <!--${Hero_Demo::DecisionAO::SM::Protected::NormalMode::SniperMode::WorldGimbal}-->
       <state name="WorldGimbal">
        <entry>me-&gt;world_enable = WORLD_ENABLE_ON;</entry>
        <exit>me-&gt;world_enable = WORLD_ENABLE_OFF;</exit>
        <!--${Hero_Demo::DecisionAO::SM::Protected::NormalMode::SniperMode::WorldGimbal::SWITCH_WORLD}-->
        <tran trig="SWITCH_WORLD" target="../..">
         <tran_glyph conn="127,103,3,3,-8">
          <action box="-8,-2,15,2"/>
         </tran_glyph>
        </tran>
        <state_glyph node="127,89,34,21">
         <entry box="0,3,6,2"/>
         <exit box="0,5,6,2"/>
        </state_glyph>
       </state>
       <state_glyph node="119,55,90,62">
        <entry box="0,3,6,2"/>
        <exit box="0,5,6,2"/>
       </state_glyph>
      </state>
      <!--${Hero_Demo::DecisionAO::SM::Protected::NormalMode::PreStair}-->
      <state name="PreStair">
       <entry>me-&gt;joint_mode = JOINT_PRESTAIR;</entry>
       <!--${Hero_Demo::DecisionAO::SM::Protected::NormalMode::PreStair::SWITCH_STAIR}-->
       <tran trig="SWITCH_STAIR" target="../..">
        <tran_glyph conn="28,83,3,3,-12">
         <action box="-12,-2,13,2"/>
        </tran_glyph>
       </tran>
       <!--${Hero_Demo::DecisionAO::SM::Protected::NormalMode::PreStair::STAIR_OK}-->
       <tran trig="STAIR_OK" target="../../10">
        <tran_glyph conn="46,81,1,3,11">
         <action box="0,-2,10,2"/>
        </tran_glyph>
       </tran>
       <state_glyph node="28,76,18,13">
        <entry box="0,3,6,2"/>
       </state_glyph>
      </state>
      <!--${Hero_Demo::DecisionAO::SM::Protected::NormalMode::StairUp}-->
      <state name="StairUp">
       <entry>me-&gt;joint_mode = JOINT_STAIRUP;</entry>
       <exit>me-&gt;joint_mode = JOINT_NORMAL;</exit>
       <!--${Hero_Demo::DecisionAO::SM::Protected::NormalMode::StairUp::SWITCH_STAIR}-->
       <tran trig="SWITCH_STAIR" target="../..">
        <tran_glyph conn="66,89,2,3,4,-50">
         <action box="-13,4,15,2"/>
        </tran_glyph>
       </tran>
       <state_glyph node="57,76,18,13">
        <entry box="0,3,6,2"/>
        <exit box="0,5,6,2"/>
       </state_glyph>
      </state>
      <!--${Hero_Demo::DecisionAO::SM::Protected::NormalMode::Stand_High}-->
      <state name="Stand_High">
       <entry>me-&gt;stand_mode = STAND_HIGH;</entry>
       <exit>me-&gt;stand_mode = STAND_NORMAL;</exit>
       <!--${Hero_Demo::DecisionAO::SM::Protected::NormalMode::Stand_High::SWITCH_STAND}-->
       <tran trig="SWITCH_STAND" target="../..">
        <tran_glyph conn="28,51,3,3,-12">
         <action box="-12,-2,16,2"/>
        </tran_glyph>
       </tran>
       <state_glyph node="28,43,18,12">
        <entry box="0,3,6,2"/>
        <exit box="0,5,6,2"/>
       </state_glyph>
      </state>
      <!--${Hero_Demo::DecisionAO::SM::Protected::NormalMode::Revolve}-->
      <state name="Revolve">
       <entry>me-&gt;chassis_mode = CHS_REVOLVE;</entry>
       <exit>me-&gt;chassis_mode = CHS_FOLLOW;</exit>
       <!--${Hero_Demo::DecisionAO::SM::Protected::NormalMode::Revolve::SWITCH_REVOLVE}-->
       <tran trig="SWITCH_REVOLVE" target="../..">
        <tran_glyph conn="28,67,3,3,-12">
         <action box="-12,-2,17,2"/>
        </tran_glyph>
       </tran>
       <state_glyph node="28,59,18,13">
        <entry box="0,3,6,2"/>
        <exit box="0,5,6,2"/>
       </state_glyph>
      </state>
      <!--${Hero_Demo::DecisionAO::SM::Protected::NormalMode::FollowBck}-->
      <state name="FollowBck">
       <entry>me-&gt;chassis_mode = CHS_FOLLOW_BACK;</entry>
       <exit>me-&gt;chassis_mode = CHS_FOLLOW;</exit>
       <!--${Hero_Demo::DecisionAO::SM::Protected::NormalMode::FollowBck::SWITCH_BACK}-->
       <tran trig="SWITCH_BACK" target="../..">
        <tran_glyph conn="28,37,3,3,-12">
         <action box="-12,-2,13,2"/>
        </tran_glyph>
       </tran>
       <state_glyph node="28,29,18,12">
        <entry box="0,3,6,2"/>
        <exit box="0,5,6,2"/>
       </state_glyph>
      </state>
      <state_glyph node="16,26,193,91">
       <entry box="0,3,6,2"/>
      </state_glyph>
     </state>
     <state_glyph node="14,14,195,104">
      <entry box="0,3,57,26"/>
     </state_glyph>
    </state>
    <state_diagram size="222,133"/>
   </statechart>
  </class>
 </package>
 <!--${Hero_Shared}-->
 <package name="Hero_Shared" stereotype="0x00">
  <!--${Hero_Shared::StateMachineSig}-->
  <attribute name="StateMachineSig" type="enum" visibility="0x04" properties="0x00">
   <code>{
    SwitchR_up_SIG=Q_USER_SIG,
    SwitchR_mid_SIG,
    SwitchR_down_SIG,
    SwitchL_up_SIG,
    SwitchL_mid_SIG,
    SwitchL_down_SIG,
    Switch_protected_SIG,
    Switch_PC_SIG,
    Switch_RC_SIG,
    RC_LOST_SIG,
    SWITCH_SNIPER_SIG,
    SWITCH_BACK_SIG,
    SWITCH_STAND_SIG,
    SWITCH_REVOLVE_SIG,
    SWITCH_WORLD_SIG,
    STAIR_OK_SIG,
    MAX_PUB_SIG,
    TIMEOUT_SIG,
    SWITCH_STAIR_SIG,
    SWITCH_FINAL_SIG,
};</code>
  </attribute>
  <!--${Hero_Shared::CtrlTerminalEnum}-->
  <attribute name="CtrlTerminalEnum" type="enum" visibility="0x04" properties="0x00">
   <code>{ CTRL_STOP = 0, CTRL_REMOTE, CTRL_PC };</code>
  </attribute>
  <!--${Hero_Shared::ChassisModeEnum}-->
  <attribute name="ChassisModeEnum" type="enum" visibility="0x04" properties="0x00">
   <code> { CHS_FOLLOW = 0, CHS_FOLLOW_BACK, CHS_REVOLVE };</code>
  </attribute>
  <!--${Hero_Shared::DecisionAO_ctor}-->
  <operation name="DecisionAO_ctor" type="void" visibility="0x00" properties="0x00">
   <code>DecisionAO * const me = &amp;DecisionAO_inst;
QActive_ctor(&amp;me-&gt;super, Q_STATE_CAST(&amp;DecisionAO_initial));
QTimeEvt_ctorX(&amp;me-&gt;timeEvt_test, &amp;me-&gt;super, TIMEOUT_SIG, 0U);
me-&gt;ctrl_terminal = CTRL_STOP;
me-&gt;chassis_mode = CHS_FOLLOW;
me-&gt;sniper = SNIPER_OFF;
me-&gt;fric_mode = FRIC_OFF;
me-&gt;stir_mode = STIR_LOCK;
me-&gt;joint_mode = JOINT_NORMAL;
me-&gt;stand_mode = STAND_NORMAL;
me-&gt;mouse_fix = MOUSE_FIX_OFF;
me-&gt;cam_target = CAM_TARGET_MID;
me-&gt;world_enable = WORLD_ENABLE_OFF;
me-&gt;rc_lost_flag = RC_LOST;
me-&gt;can_enable = CAN_DISABLE;</code>
  </operation>
  <!--${Hero_Shared::AO_DecisionAO}-->
  <attribute name="AO_DecisionAO" type="QActive * const" visibility="0x00" properties="0x00">
   <code>= &amp;DecisionAO_inst.super;</code>
  </attribute>
  <!--${Hero_Shared::pDecisionAO}-->
  <attribute name="pDecisionAO" type="const DecisionAO *" visibility="0x00" properties="0x00">
   <code>= &amp;DecisionAO_inst;</code>
  </attribute>
 </package>
 <!--${../}-->
 <directory name="../">
  <!--${../::decision_ao.h}-->
  <file name="decision_ao.h">
   <text>#ifndef DECISION_AO_H_
#define DECISION_AO_H_

#include &quot;qpc.h&quot;

$declare ${Hero_Demo::DecisionAO}

$declare ${Hero_Shared}

#endif
</text>
  </file>
  <!--${../::decision_ao.c}-->
  <file name="decision_ao.c">
   <text>#include &quot;decision_ao.h&quot;
#include &quot;general_task_include.h&quot;

$define ${Hero_Shared}
$define ${Hero_Demo::DecisionAO}</text>
  </file>
 </directory>
</model>
